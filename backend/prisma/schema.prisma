generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LegalType {
  OOO
  IP
}

enum ContractType {
  CRM
  SITE
  TRAINING
}

enum PaymentType {
  SINGLE
  DOUBLE
}

enum GenerationStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model Client {
  id                   Int        @id @default(autoincrement())
  legalType            LegalType
  name                 String
  shortName            String?
  inn                  String?
  kpp                  String?
  ogrn                 String?
  ogrnip               String?
  legalAddress         String?
  postalAddress        String?
  bankName             String?
  bankAccount          String?
  correspondentAccount String?
  bik                  String?
  signerPosition       String?
  signerFullName       String?
  signerGenitiveName   String?
  signerShortName      String?
  signerBase           String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  contracts            Contract[]
}

model Template {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  type        ContractType
  legalType   LegalType?
  paymentType PaymentType?
  hasTz       Boolean?
  filePath    String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  contracts   Contract[]
}

model Contract {
  id                  Int          @id @default(autoincrement())
  number              String       @unique
  date                DateTime
  city                String       @default("г. Пенза")
  type                ContractType
  legalType           LegalType
  paymentType         PaymentType
  hasTz               Boolean      @default(false)
  amount              Decimal      @db.Decimal(12, 2)
  amountText          String?
  prepaymentPercent   Int?
  postpaymentPercent  Int?
  prepaymentAmount    Decimal?     @db.Decimal(12, 2)
  postpaymentAmount   Decimal?     @db.Decimal(12, 2)
  servicePeriodValue  Int?
  servicePeriodUnit   String?
  tzPeriodValue       Int?
  tzPeriodUnit        String?
  warrantyPeriodValue Int?
  warrantyPeriodUnit  String?
  estimateJson        Json?
  formDataJson        Json?
  clientId            Int
  templateId          Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  client              Client       @relation(fields: [clientId], references: [id])
  template            Template?    @relation(fields: [templateId], references: [id])
  generations         Generation[]
}

model Generation {
  id             Int              @id @default(autoincrement())
  contractId     Int
  status         GenerationStatus @default(PENDING)
  fileName       String?
  filePath       String?
  errorMessage   String?
  sourceDataJson Json?
  createdBy      String?          @default("manual")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  contract       Contract         @relation(fields: [contractId], references: [id])
}

model ContractCounter {
  id        Int      @id @default(autoincrement())
  dateKey   String   @unique
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
